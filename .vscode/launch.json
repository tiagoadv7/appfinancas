{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter Web (Chrome) — Hot Reload",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "-d", "chrome",
        "--hot",
        "--web-port", "5000"
      ]
    },
    {
      "name": "Flutter Mobile — Hot Reload",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--hot"]
    }
  ]
}
